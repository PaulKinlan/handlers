{
  // The new address of the Mover demo app, for the app-migration pattern: the
  // same script and files as the hub, under its own Worker name so that it has
  // its own origin.
  "name": "ph-moved",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "MAIN_HOST": "beyondthetab.dev", "DEMO_SUFFIX": "" }
}
