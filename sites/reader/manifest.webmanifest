{
  "id": "/",
  "name": "Handlers Reader",
  "short_name": "Reader",
  "description": "Opens CSV, text and Markdown files from your file manager, and lends them to another app over a port.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edf0f4",
  "theme_color": "#3b6fe0",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/csv": [".csv"],
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      },
      "launch_type": "single-client",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
